      "email": "info@thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/SEN059x.git"
  },
  "homepage": "https://github.com/janhavelka/SEN059x",
  "license": "MIT",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "headers": ["SEN059x/SEN059x.h", "SEN059x/Version.h"],
