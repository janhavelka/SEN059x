      "include/SEN059x/Measurements.h",
      "include/SEN059x/ReadCodec.h",
      "include/SEN059x/SEN059x.h",
      "include/SEN059x/Status.h",
      "include/SEN059x/Types.h",
      "include/SEN059x/Version.h",
      "include/SEN059x/WriteCodec.h",
      "internal/WriteCodecInternal.h",
      "src/MeasurementCache.cpp",
      "src/Measurements.cpp",
      "src/MeasurementTiming.cpp",
      "src/ReadCodec.cpp",
      "src/Status.cpp",
      "src/Types.cpp",
      "src/WriteCodec.cpp",
      "LICENSE",
      "README.md",
      "CHANGELOG.md"
    ]
  }
